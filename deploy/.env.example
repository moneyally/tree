# Copy to deploy/.env and fill in. deploy/.env is never committed.

# Domain whose DNS A/AAAA records point at this server (TLS is automatic).
TREE_DOMAIN=tree.example.com

# SHA-256 (hex) of the operator token. Only the hash goes here, never the token.
#   TOKEN=$(openssl rand -hex 32); printf %s "$TOKEN" | sha256sum
# Empty = operator endpoints disabled.
ADMIN_TOKEN_SHA256=

# Signup proof-of-work difficulty (leading zero bits).
POW_BITS=20

# Log level. Logs carry only method, route, status and latency.
RUST_LOG=info

# Optional limits (defaults shown).
# MESSAGE_TTL_SECS=2592000
# PURGE_INTERVAL_SECS=3600
# MAX_MESSAGE_BYTES=262144
# MAX_RECIPIENTS=1000
# MAX_DEVICES_PER_ACCOUNT=10
# MAX_KEY_PACKAGES_PER_DEVICE=200
# RATE_PER_SEC=20
# RATE_BURST=200
# SIGNUP_PER_HOUR=20
# SIGNUP_BURST=10
