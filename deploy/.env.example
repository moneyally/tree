# Copy to deploy/.env and fill in. deploy/.env is never committed.

# Domain whose DNS A/AAAA records point at this server (TLS is automatic).
TREE_DOMAIN=tree.example.com

# SHA-256 (hex) of the operator token. Only the hash goes here, never the token.
#   TOKEN=$(openssl rand -hex 32); printf %s "$TOKEN" | sha256sum
# Empty = operator endpoints disabled.
ADMIN_TOKEN_SHA256=

# Signup proof-of-work difficulty (leading zero bits).
POW_BITS=20

# Log level. Logs carry only method, route, status and latency.
RUST_LOG=info

# Optional limits (defaults shown).
# MESSAGE_TTL_SECS=2592000
# PURGE_INTERVAL_SECS=3600
# MAX_MESSAGE_BYTES=262144
# MAX_RECIPIENTS=2048
# MAX_COMMIT_BYTES=4194304
# MAX_WELCOME_BYTES=4194304
# MAX_ATTACHMENT_BYTES=104857600
# Attachment storage bounds (F-026): bytes one account may hold, free space
# kept on the attachment disk (uploads get 507 below it), and a total for
# systems where free space cannot be read (0 = none).
# MAX_LIVE_BYTES_PER_ACCOUNT=5368709120
# MIN_FREE_DISK_BYTES=1073741824
# MAX_TOTAL_ATTACHMENT_BYTES=0

# Push wake-ups (docs/PROTOCOL.md 8.8): comma-separated push gateway hosts
# devices may register. Empty = push off. Only these hosts are contacted.
# PUSH_ALLOWED_HOSTS=push.example.com
# PUSH_INTERVAL_SECS=5
# MAX_DEVICES_PER_ACCOUNT=10
# MAX_KEY_PACKAGES_PER_DEVICE=200
# RATE_PER_SEC=20
# RATE_BURST=200
# SIGNUP_PER_HOUR=20
# SIGNUP_BURST=10
