(* Tree Protocol v1 -- NEGATIVE CONTROL for model (c).

   Identical to removal_secrecy.pv except that B, after merging the removal
   commit, still SENDS a new message in the old epoch 0 (as if the
   past-epoch window were used for sending, not only for receiving).

   Expected result: attacker(secretB1) is TRUE (the removed member reads it).
   This is why docs/PROTOCOL.md says the past-epoch window is receive-only.
*)

free c: channel.

type key.
type skey.
type pkey.
type sskey.
type spkey.

fun pk(skey): pkey.
fun aenc(pkey, key): bitstring.
reduc forall sk: skey, m: key; adec(sk, aenc(pk(sk), m)) = m.

fun spk(sskey): spkey.
fun sign(bitstring, sskey): bitstring.
reduc forall m: bitstring, k: sskey; checksign(sign(m, k), spk(k)) = m.
reduc forall m: bitstring, k: sskey; getmsg(sign(m, k)) = m.

fun kdf(key, key): key.
fun mk(key, bitstring): key.
fun senc(key, bitstring): bitstring.
reduc forall k: key, m: bitstring; sdec(k, senc(k, m)) = m.
fun eid(key): bitstring.

const removeR, update: bitstring.

free pre: bitstring [private].
free secretA1, secretB1, secretA2, secretB2: bitstring [private].

query attacker(pre).
query attacker(secretA1).
query attacker(secretB1).
query attacker(secretA2).
query attacker(secretB2).

(* Non-vacuity: every secret above is actually sent (expected: false,
   i.e. the event is reachable). *)
event ReachA2.
event ReachB2.
query event(ReachA2).
query event(ReachB2).

let A(e0: key, skA: skey, sskA: sskey, pkB: pkey, spkB: spkey) =
  (* epoch 0 -> 1: remove R; the commit secret goes to B only *)
  new cs1: key;
  let e1 = kdf(e0, cs1) in
  out(c, sign((eid(e0), removeR, aenc(pkB, cs1)), sskA));
  (!new g: bitstring; out(c, (g, senc(mk(e1, g), secretA1))))
  |
  (* epoch 1 -> 2: process B's key refresh *)
  ( in(c, x: bitstring);
    let (=eid(e1), =update, enc2: bitstring) = checksign(x, spkB) in
    let cs2 = adec(skA, enc2) in
    let e2 = kdf(e1, cs2) in
    event ReachA2;
    !new g: bitstring; out(c, (g, senc(mk(e2, g), secretA2))) ).

let B(e0: key, skB: skey, sskB: sskey, pkA: pkey, spkA: spkey) =
  (* epoch 0: a message R may read *)
  (!new g: bitstring; out(c, (g, senc(mk(e0, g), pre))))
  |
  ( in(c, x: bitstring);
    let (=eid(e0), =removeR, enc1: bitstring) = checksign(x, spkA) in
    let cs1 = adec(skB, enc1) in
    let e1 = kdf(e0, cs1) in
    (!new g: bitstring; out(c, (g, senc(mk(e0, g), secretB1))))
    |
    ( (* key refresh: epoch 1 -> 2, commit secret to A only *)
      new cs2: key;
      let e2 = kdf(e1, cs2) in
      out(c, sign((eid(e1), update, aenc(pkA, cs2)), sskB));
      event ReachB2;
      !new g: bitstring; out(c, (g, senc(mk(e2, g), secretB2))) ) ).

process
  new e0: key;
  new skA: skey; new skB: skey; new skR: skey;
  new sskA: sskey; new sskB: sskey; new sskR: sskey;
  out(c, (pk(skA), pk(skB), pk(skR), spk(sskA), spk(sskB), spk(sskR)));
  (* R's complete state at the time of removal *)
  out(c, (e0, skR, sskR));
  ( A(e0, skA, sskA, pk(skB), spk(sskB)) | B(e0, skB, sskB, pk(skA), spk(sskA)) )
